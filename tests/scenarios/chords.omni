# chords on the white keys, notes on the black, HOLD, ARP, bass, layout, key changes, saving
wait 200
expect view 0
shot boot.png
# C major, octave 3: the I chord is C3 E3 G3 (the web app's getNotes)
key w0 down
wait 30
expect deg 0
expect on48 1
expect on52 1
expect on55 1
expect nsounding 3
shot chord_I.png
key w0 up
wait 1500
expect nsounding 0
# V: G B D
key w4 down
wait 30
expect cnote0 55
expect cnote1 59
expect cnote2 62
key w4 up
# the 8th white key: I an octave up
tapkey w7
expect cnote0 60
# 7ths (KNOB 1 on PLAY): ii7 is D F A C
spin K1 1
expect par0 2
key w1 down
wait 30
expect nchord 4
expect on50 1
expect on53 1
expect on57 1
expect on60 1
shot chord_ii7.png
key w1 up
# ENV held: one more note (9th chord)
press ENV
tapkey w0
release ENV
expect nchord 5
expect view 0
# LFO held: single notes; a chord held when LFO goes down drops to its root, and comes back
press LFO
tapkey w0
expect nchord 1
release LFO
wait 500
key w4 down
wait 30
expect nsounding 4
press LFO
wait 30
expect nsounding 1
expect on55 1
release LFO
wait 30
expect nsounding 4
key w4 up
wait 1500
# LFO twice quickly: locked (lit); twice again: off
tap LFO
tap LFO
tapkey w3
expect nchord 1
shot single_lock.png
leds
wait 500
tap LFO
tap LFO
tapkey w3
expect nchord 4
spin K1 -1
# black keys: the scale's notes, an octave over the chords
key b0 down
wait 30
expect melody 60
expect on60 1
key b0 up
tapkey b4
expect melody 67
# HOLD (PLAY): the chord keeps sounding; the next chord replaces it
tap PLAY
expect hold 1
tapkey w0
wait 300
expect on48 1
tapkey w3
wait 30
expect on48 0
expect on53 1
expect on57 1
tap PLAY
expect hold 0
wait 30
expect nsounding 0
# ARP: Up at 1/8, 120 BPM: a note every 250 ms
tap ARP
expect par4 1
key w0 down
wait 10
expect arp 1
expect arpnote 48
wait 250
expect arpnote 52
wait 250
expect arpnote 55
wait 250
expect arpnote 48
shot arp.png
key w0 up
wait 20
expect arp 0
tap ARP
expect par4 0
# BASS page (EDIT twice from PLAY): -1 octave
tap HOME
tap EDIT
tap EDIT
tap EDIT
expect view 3
spin K1 1
expect par8 1
key w5 down
wait 30
expect bass 45
expect on45 1
shot bass.png
key w5 up
wait 30
expect bass 0
# REC swaps the rows: chords on the black keys, notes on the white
tap REC
expect layout 1
tapkey b2
expect deg 2
expect cnote0 52
tapkey w0
expect melody 48
tap REC
expect layout 0
# SELECT: the scale (Minor): i is C Eb G; ALGORITHM: the root (D minor)
turn SELECT 1
expect par24 1
tapkey w0
expect cnote1 51
turn ALGO 2
expect par25 2
tapkey w0
expect cnote0 50
expect cnote1 53
shot d_minor.png
# PRESETS: the sound
turn PRESET 3
expect par27 3
# OCT+
tap OCT+
expect par26 4
tapkey w0
expect cnote0 62
# it saves by itself when quiet, and comes back after a restart
wait 5000
expect dirty 0
reboot
wait 100
expect par24 1
expect par25 2
expect par27 3
expect par8 1
shot after_reboot.png
