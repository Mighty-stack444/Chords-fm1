# every sound: a I-vi-IV-V progression, its peak level; then every effect on at once
wait 100
expect par27 0
peakreset
wav sound00.wav
key w0 down
wait 450
key w0 up
wait 50
key w5 down
wait 450
key w5 up
wait 50
key w3 down
wait 450
key w3 up
wait 50
key w4 down
wait 450
key w4 up
wait 50
wait 1200
wavstop
expect peak_db_max -0.5
expect peak_db_min -24
turn PRESET 1
expect par27 1
peakreset
